# Frontend (Vite browser bundle). Use publishable values only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Backend (Go API). Keep using the publishable key plus user JWTs for Auth/GraphQL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side exchange-rate provider and local API port.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
PORT=8080

# Do not add a Supabase service-role key to the frontend bundle or this example file.
