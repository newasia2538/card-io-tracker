# Frontend (Vite browser bundle). Use publishable values only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Backend (Go API). Publishable key plus user JWTs for Auth/GraphQL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only Supabase secret key for account deactivate/reactivate/delete endpoints.
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Server-side exchange-rate provider and local API port.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
PORT=8080

# Never expose SUPABASE_SECRET_KEY to the frontend, logs, or source control.
